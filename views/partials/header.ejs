<!DOCTYPE html>
<html lang="bn">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'আইটি রিকুইজিশন ট্র্যাকার' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Baloo+Da+2:wght@600;700;800&family=Hind+Siliguri:wght@400;500;600;700&family=Space+Mono:wght@500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
<% var showChrome = (typeof user !== 'undefined' && user); %>
<% if (showChrome) { %>
<header class="top-bar">
  <div class="top-bar-row">
    <div class="brand-block">
      <div class="brand-icon">🗃️</div>
      <div>
        <div class="brand-title">আইটি রিকুইজিশন ট্র্যাকার</div>
        <div class="brand-sub">রিকুইজিশন ও গেট পাস মিলকরণ • হেড অফিস</div>
      </div>
    </div>
    <a class="top-bar-avatar" href="/profile" title="<%= user.name %>">👤</a>
  </div>
</header>
<% } %>
<div class="page<%= showChrome ? ' has-bottom-nav' : '' %>">
