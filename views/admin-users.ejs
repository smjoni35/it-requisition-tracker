<%- include('partials/header', { pageTitle: 'স্টাফ ম্যানেজমেন্ট', user: user, activeNav: activeNav }) %>

<h2>স্টাফ ম্যানেজমেন্ট</h2>
<p style="color:var(--graphite-soft); font-size:14px; margin:6px 0 20px;">যেকোনো স্টাফের পাসওয়ার্ড এখান থেকে বদলে দিতে পারবেন।</p>

<% if (error) { %><div class="error-box"><%= error %></div><% } %>
<% if (success) { %><div class="success-box"><%= success %></div><% } %>

<% users.forEach(function(u) { %>
  <div class="slip">
    <div class="slip-title"><b><%= u.name %></b> <span style="color:var(--graphite-soft); font-weight:400;">(<%= u.role === 'admin' ? 'অ্যাডমিন' : 'স্টাফ' %>)</span></div>
    <div class="profile-row">
      <span class="profile-label">ইমেইল</span>
      <span class="profile-value"><%= u.email %></span>
    </div>
    <form method="POST" action="/admin/users/<%= u.id %>/password">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label>নতুন পাসওয়ার্ড</label>
        <input type="password" name="new_password" required minlength="6">
      </div>
      <div class="field">
        <label>নতুন পাসওয়ার্ড আবার লিখুন</label>
        <input type="password" name="confirm_password" required minlength="6">
      </div>
      <button class="btn full secondary" type="submit">পাসওয়ার্ড বদলান</button>
    </form>

    <form method="POST" action="/admin/users/<%= u.id %>/role" style="margin-top:10px;">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (u.role === 'admin') { %>
        <input type="hidden" name="role" value="staff">
        <button class="btn full secondary" type="submit">স্টাফ বানান</button>
      <% } else { %>
        <input type="hidden" name="role" value="admin">
        <button class="btn full secondary" type="submit">অ্যাডমিন বানান</button>
      <% } %>
    </form>

    <form method="POST" action="/admin/users/<%= u.id %>/delete" style="margin-top:10px;" onsubmit="return confirm('<%= u.name %> কে মুছে ফেলতে চান?');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button class="btn full danger" type="submit">অ্যাকাউন্ট মুছুন</button>
    </form>
  </div>
<% }) %>

<%- include('partials/footer') %>
