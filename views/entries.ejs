<%- include('partials/header', { pageTitle: 'সব এন্ট্রি', user: user, activeNav: 'entries' }) %>

<div class="entry-top" style="margin-bottom:16px;">
  <h2>সব এন্ট্রি</h2>
  <a class="btn small" href="/entries/new">+ নতুন এন্ট্রি</a>
</div>

<form method="GET" action="/entries" class="filter-bar">
  <input type="text" name="q" value="<%= q %>" placeholder="আইটেম, রিকুইজিশন নং বা গেট পাস নং দিয়ে খুঁজুন">
  <select name="status">
    <option value="all" <%= status === 'all' ? 'selected' : '' %>>সব স্ট্যাটাস</option>
    <option value="matched" <%= status === 'matched' ? 'selected' : '' %>>মিলেছে</option>
    <option value="mismatched" <%= status === 'mismatched' ? 'selected' : '' %>>মিলেনি</option>
    <option value="partial" <%= status === 'partial' ? 'selected' : '' %>>আংশিক</option>
    <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>অপেক্ষমান</option>
  </select>
  <button class="btn small secondary" type="submit">খুঁজুন</button>
</form>

<div class="toolbar-row">
  <a class="toolbar-link" href="/entries/print?q=<%= encodeURIComponent(q) %>&status=<%= status %>"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9V3h12v6M6 18H4a1 1 0 0 1-1-1v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6a1 1 0 0 1-1 1h-2"/><rect x="6" y="14" width="12" height="7"/></svg> প্রিন্ট রিপোর্ট</a>
  <a class="toolbar-link" href="/entries/export/excel?q=<%= encodeURIComponent(q) %>&status=<%= status %>"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/></svg> এক্সেল এক্সপোর্ট</a>
  <a class="toolbar-link" href="/entries/import"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5M4 20h16"/></svg> CSV ইম্পোর্ট</a>
  <a class="toolbar-link" href="/mismatches"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l10 18H2L12 3zM12 10v5M12 18h.01"/></svg> অমিল তালিকা</a>
  <a class="toolbar-link" href="/activity"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg> অ্যাক্টিভিটি লগ</a>
</div>

<div style="color:var(--graphite-soft); font-size:13px; margin:4px 0 14px;">মোট <%= totalCount %>টি এন্ট্রি পাওয়া গেছে</div>

<% const labels = { matched: 'মিলেছে', mismatched: 'মিলেনি', partial: 'আংশিক', pending: 'অপেক্ষমান' }; %>

<% if (entries.length === 0) { %>
  <div class="empty-state">
    কোনো এন্ট্রি পাওয়া যায়নি।<br>
    <a class="btn small" style="margin-top:12px;" href="/entries/new">প্রথম এন্ট্রি যোগ করুন</a>
  </div>
<% } %>

<% entries.forEach(function(e) {
  var rq = Number(e.req_qty) || 0, rc = Number(e.received_qty) || 0;
  var pct = rq > 0 ? Math.min(100, Math.round(rc / rq * 100)) : (rc > 0 ? 100 : 0); %>
  <article class="entry-card <%= e.status %>">
    <div class="entry-top">
      <div>
        <div class="entry-name"><%= e.item_name %></div>
        <% if (e.creator_name) { %><div class="entry-desc"><%= e.creator_name %></div><% } %>
      </div>
      <span class="stamp <%= e.status %>"><%= labels[e.status] || e.status %></span>
    </div>

    <div class="ledger">
      <div>
        <div class="ledger-h">রিকুইজিশন</div>
        <div class="ledger-no mono"><%= e.req_no || '—' %></div>
        <div class="ledger-q"><b><%= e.req_qty %></b><%= e.unit || '' %></div>
      </div>
      <div>
        <div class="ledger-h">গেট পাস</div>
        <div class="ledger-no mono"><%= e.gatepass_no || '—' %></div>
        <div class="ledger-q"><b><%= e.received_qty %></b><%= e.unit || '' %></div>
      </div>
    </div>
    <div class="qbar" title="প্রাপ্ত <%= pct %>%"><span style="width:<%= pct %>%"></span></div>

    <% var atts = (typeof attachmentsByEntry !== 'undefined' && attachmentsByEntry[e.id]) || []; %>
    <% if (atts.length > 0) { %>
      <div class="attach-row">
        <% atts.forEach(function(a) { if (a.mime.indexOf('image/') === 0) { %>
          <a href="/attachments/<%= a.id %>" target="_blank" rel="noopener" class="entry-thumb-link"><img class="entry-thumb" src="/attachments/<%= a.id %>" alt="<%= a.filename %>" loading="lazy"></a>
        <% } else { %>
          <a href="/attachments/<%= a.id %>" class="attach-chip"><%= a.filename %></a>
        <% } }) %>
      </div>
    <% } %>

    <details class="status-edit">
      <summary>স্ট্যাটাস বদলান<% if (e.status_note) { %> • <span style="color:var(--graphite-soft);font-weight:400"><%= e.status_note %></span><% } %></summary>
      <form class="status-select-form" method="POST" action="/entries/<%= e.id %>/status">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <select name="manual_status">
          <option value="auto" <%= !e.manual_status ? 'selected' : '' %>>অটো (<%= labels[e.auto_status] %>)</option>
          <option value="matched" <%= e.manual_status === 'matched' ? 'selected' : '' %>>মিলেছে</option>
          <option value="mismatched" <%= e.manual_status === 'mismatched' ? 'selected' : '' %>>মিলেনি</option>
          <option value="partial" <%= e.manual_status === 'partial' ? 'selected' : '' %>>আংশিক</option>
          <option value="pending" <%= e.manual_status === 'pending' ? 'selected' : '' %>>অপেক্ষমান</option>
        </select>
        <input type="text" name="status_note" placeholder="নোট (ঐচ্ছিক)" value="<%= e.status_note || '' %>">
        <button class="btn small secondary" type="submit">সংরক্ষণ</button>
      </form>
    </details>

    <div class="entry-links">
      <a href="/entries/<%= e.id %>/edit">এডিট</a>
      <% if (user.role === 'admin') { %>
        <form method="POST" action="/entries/<%= e.id %>/delete" onsubmit="return confirm('এই এন্ট্রি মুছে ফেলতে চান?');">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit">মুছুন</button>
        </form>
      <% } %>
    </div>
  </article>
<% }); %>

<% if (totalPages > 1) { %>
  <div class="pagination">
    <% if (currentPage > 1) { %>
      <a class="btn small secondary" href="/entries?page=<%= currentPage - 1 %>&q=<%= encodeURIComponent(q) %>&status=<%= status %>">← আগের</a>
    <% } %>
    <span class="pagination-info"><%= currentPage %> / <%= totalPages %></span>
    <% if (currentPage < totalPages) { %>
      <a class="btn small secondary" href="/entries?page=<%= currentPage + 1 %>&q=<%= encodeURIComponent(q) %>&status=<%= status %>">পরের →</a>
    <% } %>
  </div>
<% } %>

<%- include('partials/footer') %>
