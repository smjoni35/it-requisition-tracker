<%- include('partials/header', { pageTitle: 'সারসংক্ষেপ', user: user, activeNav: 'dashboard' }) %>
<% var pc = function (n) { return total ? (n / total * 100) : 0; }; %>

<div class="page-head">
  <div>
    <h2>সারসংক্ষেপ</h2>
    <p>মোট <%= total %>টি এন্ট্রির মিলকরণের বর্তমান অবস্থা</p>
  </div>
  <div class="actions-row" style="margin:0;">
    <a class="btn small" href="/entries/new">+ নতুন এন্ট্রি</a>
    <a class="btn small secondary" href="/entries/print">রিপোর্ট প্রিন্ট / PDF</a>
    <a class="btn small secondary" href="/entries/export/excel">এক্সেল</a>
  </div>
</div>

<div class="panel">
  <div class="rate-row">
    <div class="rate-num"><%= matchRate %>%</div>
    <div class="rate-note">রিকুইজিশন সঠিকভাবে মিলেছে</div>
  </div>
  <div class="seg" role="img" aria-label="স্ট্যাটাস অনুযায়ী ভাগ">
    <span class="c-matched" style="width:<%= pc(stats.matched) %>%"></span>
    <span class="c-partial" style="width:<%= pc(stats.partial) %>%"></span>
    <span class="c-mismatched" style="width:<%= pc(stats.mismatched) %>%"></span>
    <span class="c-pending" style="width:<%= pc(stats.pending) %>%"></span>
  </div>
  <div class="legend">
    <a href="/entries?status=matched"><i class="c-matched"></i><span>মিলেছে</span><b><%= stats.matched %></b></a>
    <a href="/entries?status=partial"><i class="c-partial"></i><span>আংশিক</span><b><%= stats.partial %></b></a>
    <a href="/entries?status=mismatched"><i class="c-mismatched"></i><span>মিলেনি</span><b><%= stats.mismatched %></b></a>
    <a href="/entries?status=pending"><i class="c-pending"></i><span>অপেক্ষমান</span><b><%= stats.pending %></b></a>
  </div>
</div>

<div class="panel">
  <div class="panel-title">পরিমাণ: চাহিদা বনাম প্রাপ্ত</div>
  <div class="figs">
    <div><b><%= totalReq %></b><span>মোট চাহিদা</span></div>
    <div><b><%= totalRecv %></b><span>মোট প্রাপ্ত</span></div>
    <div><b><%= diff %></b><span>পার্থক্য</span></div>
  </div>
  <div class="qbar"><span style="width:<%= Number(totalReq) > 0 ? Math.min(100, Math.round(Number(totalRecv) / Number(totalReq) * 100)) : 0 %>%"></span></div>
</div>

<div class="panel">
  <div class="panel-title">গত ১৪ দিনের ট্রেন্ড</div>
  <canvas id="trendChart" height="180"></canvas>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js" nonce="<%= cspNonce %>"></script>
<script nonce="<%= cspNonce %>">
  const trend = <%- JSON.stringify(trend) %>;
  const ctx = document.getElementById('trendChart');
  if (ctx && trend.length) {
    Chart.defaults.font.family = '"Hind Siliguri", sans-serif';
    Chart.defaults.color = '#65728a';
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: trend.map(function (r) { return r.day.slice(5); }),
        datasets: [
          { label: 'মোট এন্ট্রি', data: trend.map(function (r) { return r.total; }), borderColor: '#1c3f66', backgroundColor: 'rgba(28,63,102,0.08)', tension: 0.35, fill: true, pointRadius: 2 },
          { label: 'মিলেছে', data: trend.map(function (r) { return r.matched; }), borderColor: '#1f7a4c', backgroundColor: 'rgba(31,122,76,0.08)', tension: 0.35, fill: true, pointRadius: 2 }
        ]
      },
      options: {
        responsive: true,
        plugins: { legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8 } } },
        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 }, grid: { color: '#eef1f5' } }, x: { grid: { display: false } } }
      }
    });
  }
</script>

<%- include('partials/footer') %>
