<%- include('partials/header', { pageTitle: 'সারসংক্ষেপ', user: user }) %>

<a class="btn print-btn full" href="/entries/print">🖨️ পূর্ণ রিপোর্ট প্রিন্ট / PDF সেভ করুন</a>

<div class="hero-card">
  <div class="hero-text">
    <div class="hero-eyebrow">মোট <%= total %>টি এন্ট্রি</div>
    <div class="hero-title">মিলে যাওয়ার হার</div>
    <div class="hero-desc">সঠিকভাবে যাচাইকৃত রিকুইজিশনের হার এখানে দেখা যাচ্ছে</div>
  </div>
  <div class="progress-ring" style="--pct: <%= matchRate %>;">
    <div class="progress-ring-inner">
      <div class="progress-ring-num"><%= matchRate %>%</div>
    </div>
  </div>
</div>

<div class="stat-grid">
  <div class="stat-tile">
    <div class="stat-icon-badge badge-green">✓</div>
    <div class="stat-num"><%= stats.matched %></div>
    <div class="stat-label">মিলেছে</div>
  </div>
  <div class="stat-tile">
    <div class="stat-icon-badge badge-red">✕</div>
    <div class="stat-num"><%= stats.mismatched %></div>
    <div class="stat-label">মিলেনি</div>
  </div>
  <div class="stat-tile">
    <div class="stat-icon-badge badge-amber">!</div>
    <div class="stat-num"><%= stats.partial %></div>
    <div class="stat-label">আংশিক মিলেছে</div>
  </div>
  <div class="stat-tile">
    <div class="stat-icon-badge badge-grey">…</div>
    <div class="stat-num"><%= stats.pending %></div>
    <div class="stat-label">অপেক্ষমান</div>
  </div>
</div>

<div class="totals-card">
  <div class="totals-item">
    <div class="totals-num mono"><%= totalReq %></div>
    <div class="totals-label">মোট চাহিদা</div>
  </div>
  <div class="totals-item">
    <div class="totals-num mono"><%= totalRecv %></div>
    <div class="totals-label">মোট প্রাপ্ত</div>
  </div>
  <div class="totals-item">
    <div class="totals-num mono"><%= diff %></div>
    <div class="totals-label">পার্থক্য</div>
  </div>
</div>

<div class="slip">
  <div class="slip-title"><b>গত ১৪ দিনের ট্রেন্ড</b></div>
  <canvas id="trendChart" height="180"></canvas>
</div>

<div class="toolbar-row">
  <a class="toolbar-link" href="/activity">📜 অ্যাক্টিভিটি লগ</a>
  <a class="toolbar-link" href="/entries/import">⬆️ CSV ইম্পোর্ট</a>
  <a class="toolbar-link" href="/entries/export/excel">📊 এক্সেল এক্সপোর্ট</a>
</div>

<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>
<script>
  const trend = <%- JSON.stringify(trend) %>;
  const ctx = document.getElementById('trendChart');
  if (ctx && trend.length) {
    new Chart(ctx, {
      type: 'line',
      data: {
        labels: trend.map(function (r) { return r.day.slice(5); }),
        datasets: [
          {
            label: 'মোট এন্ট্রি',
            data: trend.map(function (r) { return r.total; }),
            borderColor: '#5b3ff2',
            backgroundColor: 'rgba(91,63,242,0.12)',
            tension: 0.3,
            fill: true
          },
          {
            label: 'মিলেছে',
            data: trend.map(function (r) { return r.matched; }),
            borderColor: '#16915f',
            backgroundColor: 'rgba(22,145,95,0.12)',
            tension: 0.3,
            fill: true
          }
        ]
      },
      options: {
        responsive: true,
        plugins: { legend: { position: 'bottom' } },
        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
      }
    });
  }
</script>

<%- include('partials/footer') %>
