<%- include('partials/header', { pageTitle: 'সারসংক্ষেপ', user: user }) %>

<h2>সারসংক্ষেপ লেজার</h2>
<p style="color:#5c5a52; font-size:14px; margin:6px 0 20px;">মোট <b class="mono"><%= total %></b>টি এন্ট্রির অবস্থা</p>

<div class="tally">
  <div class="tally-cell matched">
    <div class="tally-num"><%= stats.matched %></div>
    <div class="tally-label">মিলেছে</div>
  </div>
  <div class="tally-cell mismatched">
    <div class="tally-num"><%= stats.mismatched %></div>
    <div class="tally-label">মিলেনি</div>
  </div>
  <div class="tally-cell partial">
    <div class="tally-num"><%= stats.partial %></div>
    <div class="tally-label">আংশিক</div>
  </div>
  <div class="tally-cell pending">
    <div class="tally-num"><%= stats.pending %></div>
    <div class="tally-label">অপেক্ষমান</div>
  </div>
</div>

<div class="rate-block">
  <div class="rate-top">
    <div class="rate-num"><%= matchRate %>%</div>
    <div class="rate-desc">সঠিকভাবে মিলে যাওয়া রিকুইজিশনের হার</div>
  </div>
  <div class="rate-track">
    <div class="rate-fill" style="width: <%= matchRate %>%;"></div>
  </div>
  <div class="totals-row">
    <span>মোট চাহিদা: <b class="mono"><%= totalReq %></b></span>
    <span>মোট প্রাপ্ত: <b class="mono"><%= totalRecv %></b></span>
    <span>পার্থক্য: <b class="mono"><%= diff %></b></span>
  </div>
</div>

<div class="actions-row">
  <a class="btn" href="/entries/new">+ নতুন এন্ট্রি</a>
  <a class="btn secondary" href="/entries">সব এন্ট্রি দেখুন</a>
</div>

<%- include('partials/footer') %>
